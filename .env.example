# Runtime mode and host ports
FLASK_ENV=development
FLASK_DEBUG=1
BACKEND_PORT=5000
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
MAILHOG_UI_PORT=8026
MAILHOG_SMTP_PORT=1025

# Initial administrator (use strong production values)
SUPERUSER=System Admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASS=change-me-development-only

# MySQL (passwords must be set in production)
MYSQL_ROOT_PASSWORD=development-root-password
MYSQL_DATABASE=progress_db
MYSQL_USER=progress_user
MYSQL_PASSWORD=development-db-password
DATABASE_URL=mysql+pymysql://progress_user:development-db-password@db:3306/progress_db

# Flask and browser access
SECRET_KEY=change-me-development-only
DB_FILE=app.db
URL_PREFIX=
FRONTEND_URL=http://localhost:5174
FRONTEND_BASE_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5174,http://localhost:4173
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_HTTPONLY=true
WTF_CSRF_ENABLED=false
TESTING=false

# Common Identity Hub / OpenID Connect
OIDC_ISSUER_URL=http://auth.local:8080/realms/anzai-home
OIDC_CLIENT_ID=task-progress-manager
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5000/sessions/oidc/callback
OIDC_FRONTEND_REDIRECT_URL=http://localhost:5174/

# OpenAPI
API_TITLE=Task Progress API
API_VERSION=1.0.0
OPENAPI_VERSION=3.0.3
OPENAPI_URL_PREFIX=/doc
OPENAPI_JSON_PATH=openapi.json
OPENAPI_REDOC_PATH=/redoc
OPENAPI_REDOC_URL=https://cdn.jsdelivr.net/npm/redoc@2/bundles/redoc.standalone.js
OPENAPI_SWAGGER_UI_PATH=/swagger-ui
OPENAPI_SWAGGER_UI_URL=https://cdn.jsdelivr.net/npm/swagger-ui-dist/

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=false
CELERY_TASK_IGNORE_RESULT=false

# SMTP (Mailhog defaults for development)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT=30
MAIL_FROM=test-support@test.com
MAIL_REPLY_TO=test-support@test.com
MAIL_RETURN_PATH=test-support@test.com

# Gemini (required only for AI suggestions)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# Frontend and Playwright
VITE_API_BASE_URL=/api
VITE_OPENAPI_URL=http://localhost:5000/doc/openapi.json
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
